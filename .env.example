# 复制为 .env.local（已被 .gitignore 忽略）后运行 `pnpm smoke:sub2api`。
# 不要把真实 Key 写进任何会被分享或提交的文件。
SUB2API_BASE_URL=https://your-sub2api.example.com
SUB2API_API_KEY=
# 可选：逗号分隔的候选模型，默认只测轻量版 gpt-5.6-luna
SUB2API_MODELS=gpt-5.6-luna
# 可选：auto | responses | chat
SUB2API_PROTOCOL=auto
# 可选：设置后额外实测 sub2api 语音合成 / 语音识别（各一次计费调用）
SUB2API_TTS_MODEL=
SUB2API_TTS_VOICE=
SUB2API_ASR_MODEL=
